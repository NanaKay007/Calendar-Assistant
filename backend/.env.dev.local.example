# Local development & test environment — loaded for all non-production profiles.
# Copy to .env.dev.local and fill in your values.

PORT=3000
NODE_ENV=development

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback

SESSION_SECRET=change-me-to-any-random-string

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=calendar-assistant

FRONTEND_URL=http://localhost:5173

# Integration testing (required for `npm test`)
# Obtain a refresh token by completing the OAuth flow once (see README).
GOOGLE_TEST_REFRESH_TOKEN=
