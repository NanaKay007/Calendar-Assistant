# Production environment — loaded when NODE_ENV=production
# Filename: .env

PORT=3000
NODE_ENV=production

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-production-domain.com/api/auth/callback

SESSION_SECRET=

# Encryption key for OAuth tokens at rest (hex-encoded 32-byte key).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=  # Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.example.mongodb.net
MONGODB_DB_NAME=calendar-assistant

FRONTEND_URL=https://your-production-domain.com
